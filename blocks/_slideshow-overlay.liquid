{% assign overlay_type = block.settings.home_hero_overlay_type | default: 'fullScreen' %}
{% assign use_custom_blocks = false %}
{% if block.blocks.size > 0 %}
  {% assign use_custom_blocks = true %}
{% endif %}

<style>
  .slideshow-section--{{ section.id }} .slideshow__overlay:before {
    background-color: {{ block.settings.color_image_overlay }};
    opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.00 }};
  }

  .sale-promo {
    width: 100%;
    text-align: left;
    color: inherit;
  }

  .sale-promo__badge {
    display: inline-block;
    margin: 0 0 0.85rem;
    padding: 0.35em 0.7em 0.3em;
    background: #000;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sale-promo__offer {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    overflow: visible;
  }

  @media screen and (max-width: 768px) {
    .sale-promo {
      text-align: center;
    }

    .sale-promo__offer {
      max-width: 280px;
      margin: 0 auto;
    }
  }

  .sale-promo__title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
  }

  .sale-promo__label {
    margin: 0 0 0.35em;
    font-size: 18px;
    font-weight: 700;
  }

  .sale-promo__series {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 23px;
    line-height: 1.2;
    font-weight: 400;
  }

  .sale-promo__cta {
    margin: 0;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.4;
  }

  .sale-promo__cta strong {
    font-weight: 700;
    text-transform: uppercase;
  }

  .sale-promo__rule {
    border: 0;
    margin: 1.1rem 0;
    width: 100%;
    height: 0;
  }

  .sale-promo__gap {
    height: 0.85rem;
  }


  @media screen and (min-width: 769px) {
    .sale-promo__badge {
      position: absolute;
      top: 24px;
      left: 50%;
      z-index: 2;
      margin: 0;
      font-size: 15px;
      transform: translateX(-50%);
    }

    .sale-promo__title {
      font-size: 22px;
      margin-bottom: 24px;
    }

    .sale-promo__label {
      font-size: 16px;
    }

    .sale-promo__cta {
      font-size: 15px;
    }

    .sale-promo__series {
      font-size: 23px;
      line-height: 1.2;
    }
  }

  @media screen and (min-width: 1200px) {
    .sale-promo__badge {
      font-size: 16px;
    }

    .sale-promo__title {
      font-size: 24px;
    }

    .sale-promo__label {
      font-size: 18px;
    }

    .sale-promo__cta {
      font-size: 19px;
    }

    .sale-promo__series {
      font-size: 28px;
    }
  }

</style>

<div
  class="slideshow__overlay slideshow__overlay--{{ overlay_type }}"
  style="color: {{ section.settings.slide_text_color }};"
  {{ block.shopify_attributes }}
>
  <div class="slideshow-overlay__align">
    <div class="slideshow-overlay__content">
      {% if use_custom_blocks %}
        {% content_for 'blocks' %}
      {% else %}
        <div class="sale-promo">
          {% if block.settings.badge_text != blank %}
            <p class="sale-promo__badge">{{ block.settings.badge_text | escape }}</p>
          {% endif %}

          <svg
            class="sale-promo__offer"
            viewBox="0 0 240 145"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="50% off"
            focusable="false"
          >
            <g
              fill="currentColor"
              font-family="'Arial Black', 'Helvetica Neue', Helvetica, Arial, sans-serif"
              font-weight="900"
            >
              <text x="0" y="122" font-size="136" letter-spacing="-8">50</text>
              <text x="168" y="72" font-size="64" letter-spacing="-2">%</text>
              <text x="170" y="118" font-size="46" letter-spacing="0">off</text>
            </g>
          </svg>

          <hr class="sale-promo__rule" aria-hidden="true">

          {% if block.settings.title_text != blank %}
            <p class="sale-promo__title">{{ block.settings.title_text | escape }}</p>
          {% endif %}

          <div class="sale-promo__gap" aria-hidden="true"></div>

          {% if block.settings.series_label != blank %}
            <p class="sale-promo__label">{{ block.settings.series_label | escape }}</p>
          {% endif %}

          <ul class="sale-promo__series">
            {% if block.settings.series_1 != blank %}
              <li>{{ block.settings.series_1 | escape }}</li>
            {% endif %}
            {% if block.settings.series_2 != blank %}
              <li>{{ block.settings.series_2 | escape }}</li>
            {% endif %}
            {% if block.settings.series_3 != blank %}
              <li>{{ block.settings.series_3 | escape }}</li>
            {% endif %}
          </ul>

          <hr class="sale-promo__rule" aria-hidden="true">

          {% if block.settings.cta_text != blank or block.settings.cta_code != blank %}
            <p class="sale-promo__cta">
              {{ block.settings.cta_text | escape }}
              {% if block.settings.cta_code != blank %}
                <strong>{{ block.settings.cta_code | escape }}</strong>
              {% endif %}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% unless block.settings.slide_cta == blank %}
        <a
          href="{{ block.settings.slide_link }}"
          style="color: {{ section.settings.slide_button_label_color }}; background-color: {{ section.settings.slide_button_background_color }}"
          class="btn hero__cta"
        >
          {{ block.settings.slide_cta | escape }}
        </a>
      {% endunless %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Overlay",
  "tag": null,
  "blocks": [
    { "type": "_spacer" },
    { "type": "_text" },
    { "type": "_rich-text" },
    { "type": "_divider" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "color_image_overlay",
      "label": "Overlay",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "home_hero_overlay_type",
      "label": "Overlay type",
      "default": "column",
      "options": [
        {
          "value": "fullScreen",
          "label": "Full screen"
        },
        {
          "value": "column",
          "label": "Column"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Sale promo",
      "info": "Used when no nested text/divider blocks are added. Add blocks in the overlay to override this layout."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "WINTER SALE"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer",
      "default": "50% off"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title",
      "default": "All original Screenprints"
    },
    {
      "type": "text",
      "id": "series_label",
      "label": "Series label",
      "default": "Including Series"
    },
    {
      "type": "text",
      "id": "series_1",
      "label": "Series 1",
      "default": "Liverpool ONE"
    },
    {
      "type": "text",
      "id": "series_2",
      "label": "Series 2",
      "default": "The Beatles"
    },
    {
      "type": "text",
      "id": "series_3",
      "label": "Series 3",
      "default": "Mann Island"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Contact us and use code"
    },
    {
      "type": "text",
      "id": "cta_code",
      "label": "CTA code",
      "default": "WINTER50"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "slide_cta",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "slide_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
