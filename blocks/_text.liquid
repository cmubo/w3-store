{% liquid
  assign font = block.settings.font
  assign font_size = block.settings.font_size
  assign font_size_mobile = block.settings.font_size_mobile
  assign alignment = block.settings.text_alignment | default: 'center'
%}

{% style %}
  {{ font | font_face: font_display: 'swap' }}

  .hero-text--{{ block.id }} {
    font-family: {{ font.family }}, {{ font.fallback_families }};
    font-weight: {{ font.weight }};
    font-style: {{ font.style }};
    font-size: {{ font_size_mobile }}px;
    margin: 0;
    text-align: {{ alignment }};
    width: 100%;
  }

  @media screen and (min-width: 769px) {
    .hero-text--{{ block.id }} {
      font-size: {{ font_size }}px;
    }
  }
{% endstyle %}

<p class="hero__text hero-text--{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.text != blank %}
    {{ block.settings.text | escape }}
  {% endif %}
</p>

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "An introductory"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "neue_haas_unica_n7"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
